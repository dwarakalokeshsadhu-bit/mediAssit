# ==============================================================================
# MedAssist Server Environment Configuration Template
# ==============================================================================

# Server Network & Environment
PORT=5000
NODE_ENV=production

# Authenticated MongoDB Atlas Cloud URI
MONGO_URI=MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<dbname>

# Local Fallback URI (if running locally without Atlas):
# MONGO_URI=mongodb://127.0.0.1:27017/medassist

# JWT Authentication
JWT_SECRET=medassist_super_secret_jwt_key_2026_capstone_secure
JWT_EXPIRES_IN=7d

# Cross-Origin Resource Sharing (CORS)
# Multiple origins can be comma-separated: https://your-app.vercel.app,https://your-domain.com
CLIENT_URL=http://localhost:5173

# Optional: Google Gemini API Key for AI Clinical Consultation Summaries
GEMINI_API_KEY=
