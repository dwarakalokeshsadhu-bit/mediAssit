{
  "name": "medassist-portal",
  "version": "1.0.0",
  "private": true,
  "description": "MedAssist – Clinic Operations & Patient Care Portal",
  "type": "module",
  "scripts": {
    "install:server": "npm --prefix server install",
    "install:client": "npm --prefix client install",
    "install-all": "npm --prefix server install && npm --prefix client install",
    "build": "npm --prefix client run build",
    "start": "node server/src/index.js",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "npm --prefix client run dev",
    "seed": "node server/src/seed/seed.js"
  }
}
